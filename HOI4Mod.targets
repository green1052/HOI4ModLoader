<Project>

    <!--
      A project (a plugin, or the loader itself) may ship a regular HOI4 mod in its mod\ folder (descriptor.mod + game files). After build it is copied to
      Documents\Paradox Interactive\Hearts of Iron IV\mod\<ProjectName> with a matching .mod file; enable it in the launcher.
      Files built from the installed game (GuiPatch.cs) are written into the installed mod when the game starts.
    -->
    <Target Name="DeployHOI4Mod" AfterTargets="Build" Condition="Exists('mod\descriptor.mod') And '$(HOI4ModPath)' != ''">
        <ItemGroup>
            <_HOI4ModFile Include="mod\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_HOI4ModFile)" DestinationFiles="@(_HOI4ModFile->'$(HOI4ModPath)\$(MSBuildProjectName)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
        <WriteLinesToFile File="$(HOI4ModPath)\$(MSBuildProjectName).mod" Overwrite="true" WriteOnlyWhenDifferent="true"
                          Lines="$([System.IO.File]::ReadAllText('mod\descriptor.mod'));path=&quot;mod/$(MSBuildProjectName)&quot;" />
    </Target>

</Project>
