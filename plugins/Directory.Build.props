<Project>

    <!-- Shared by every plugin under plugins\: a plugin project is just a .csproj and its .cs files. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <ItemGroup>
        <!-- Provided at runtime by HOI4ModLoader\core. -->
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\HOI4ModLoader\HOI4ModLoader.csproj" Private="false" />
    </ItemGroup>

</Project>
