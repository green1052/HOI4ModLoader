<Project>

    <!-- Every build copies the plugin (and its symbols) into <DeployDir>\HOI4ModLoader\plugins; a running game hot reloads it. -->
    <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployPath)' != ''">
        <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(DeployPath)\HOI4ModLoader\plugins" SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" />
    </Target>

    <Import Project="$(MSBuildThisFileDirectory)..\HOI4Mod.targets" />

</Project>
