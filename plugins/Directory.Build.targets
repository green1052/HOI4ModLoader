<Project>

    <!-- Every build copies the plugin into <DeployDir>\hoi4mods\plugins. Locked files (game running) only warn. -->
    <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(DeployDir)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)\hoi4mods\plugins" SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" />
    </Target>

    <!--
      A plugin may ship a regular HOI4 mod in its mod\ folder (descriptor.mod + game files). After build it is copied to
      Documents\Paradox Interactive\Hearts of Iron IV\mod\<ProjectName> with a matching .mod file; enable it in the launcher.
      Plugins can add generated files as <HOI4ModFile Include="..." Link="interface\x.gui" /> before DeployHOI4Mod runs.
    -->
    <Target Name="DeployHOI4Mod" AfterTargets="Build" Condition="Exists('mod\descriptor.mod') And '$(HOI4ModDir)' != ''">
        <ItemGroup>
            <HOI4ModFile Include="mod\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" />
        </ItemGroup>
        <Copy SourceFiles="@(HOI4ModFile)" DestinationFiles="@(HOI4ModFile->'$(HOI4ModDir)\$(MSBuildProjectName)\%(Link)')" SkipUnchangedFiles="true" />
        <WriteLinesToFile File="$(HOI4ModDir)\$(MSBuildProjectName).mod" Overwrite="true"
                          Lines="$([System.IO.File]::ReadAllText('mod\descriptor.mod'));path=&quot;mod/$(MSBuildProjectName)&quot;" />
    </Target>

</Project>
