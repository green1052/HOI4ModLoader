guiTypes = {
	# Queues: queue position badge, created at runtime on tech tree items and focus tree items.
	# A new template in its own file, so no vanilla or mod GUI file is overridden.
	containerWindowType = {
		name = "hoimod_queue_number"
		position = { x = 0 y = 0 }
		size = { width = 24 height = 22 }
		clipping = no

		instantTextboxType = {
			name = "hoimod_queue"
			position = { x = 0 y = 0 }
			font = "hoi_18mbs"
			text = ""
			maxWidth = 24
			maxHeight = 22
			format = center
			vertical_alignment = center
			alwaystransparent = yes
		}
	}
}
