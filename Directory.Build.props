<Project>

    <PropertyGroup>
        <!-- Game folder: Steam's uninstall entry for app 394360. Override with -p:HOI4Dir=... or the HOI4Dir environment variable. -->
        <HOI4Dir Condition="'$(HOI4Dir)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 394360', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</HOI4Dir>
        <!-- Every build deploys into the game (version.dll + HOI4ModLoader\). -p:DeployDir=/-p:HOI4ModDir= (see README) point it elsewhere or turn it off. -->
        <DeployDir Condition="'$(DeployDir)' == ''">$(HOI4Dir)</DeployDir>
        <!-- Regular HOI4 (Paradox) mods that some plugins ship, e.g. GUI files. -->
        <HOI4ModDir Condition="'$(HOI4ModDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))\Paradox Interactive\Hearts of Iron IV\mod</HOI4ModDir>
    </PropertyGroup>

    <!-- Every project: the loader, the plugins (hosted in the 64-bit game) and the tests. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

</Project>
