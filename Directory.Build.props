<Project>

    <PropertyGroup>
        <!-- Game folder: Steam's uninstall entry for app 394360. Override with -p:HOI4Dir=... or the HOI4Dir environment variable. -->
        <HOI4Dir Condition="'$(HOI4Dir)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 394360', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</HOI4Dir>
        <!-- Every build deploys into the game (version.dll + HOI4ModLoader\). -p:DeployDir=/-p:HOI4ModDir= (see README) point it elsewhere or turn it off. -->
        <DeployDir Condition="'$(DeployDir)' == ''">$(HOI4Dir)</DeployDir>
        <!-- Regular HOI4 (Paradox) mods that some plugins ship, e.g. GUI files. -->
        <HOI4ModDir Condition="'$(HOI4ModDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))\Paradox Interactive\Hearts of Iron IV\mod</HOI4ModDir>
        <!-- Where they resolve to: relative paths are from this folder (the repository), the same for every project and shell. -->
        <DeployPath Condition="'$(DeployDir)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(DeployDir)'))))</DeployPath>
        <!-- Symbols (.pdb: line numbers in LogOutput.log, debugging) go out with Debug builds only. -->
        <DeploySymbols Condition="'$(DeploySymbols)' == ''">$([System.String]::Equals('$(Configuration)', 'Debug'))</DeploySymbols>
        <HOI4ModPath Condition="'$(HOI4ModDir)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(HOI4ModDir)'))))</HOI4ModPath>
    </PropertyGroup>

    <!-- Every project: the loader, the plugins (hosted in the 64-bit game) and the tests. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <!-- Translations (Loc.cs): localisation\<language>.yml, embedded as "localisation/<language>.yml". -->
    <ItemGroup>
        <EmbeddedResource Include="localisation\*.yml" LogicalName="localisation/%(Filename).yml" />
        <!-- GUI snippets ([assembly: GuiPatch], GuiPatch.cs): gui\<name>.gui, embedded as "gui/<name>.gui". -->
        <EmbeddedResource Include="gui\*.gui" LogicalName="gui/%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
