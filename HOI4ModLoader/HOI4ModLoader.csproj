<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The loader's version: the main menu, the Mods tab and the log show it. -->
        <Version>1.3.0</Version>
        <!-- Hosted from native code (bootstrap): emits runtimeconfig.json and copies dependencies. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Signatures.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Reloaded.Hooks" Version="4.3.3" />
    </ItemGroup>

    <ItemGroup>
        <BootstrapSource Include="..\bootstrap\*.c;..\bootstrap\*.cs;..\bootstrap\Bootstrap.csproj" />
        <None Include="@(BootstrapSource)" LinkBase="bootstrap" />
    </ItemGroup>

    <!--
      bootstrap\ (version.dll: Native AOT C# plus C) is published, not built, so it isn't in the .slnx: this project
      publishes it when its sources change. It needs the Visual Studio C++ build tools (the linker and the C compiler).
    -->
    <PropertyGroup>
        <BootstrapDll>$(MSBuildThisFileDirectory)..\bootstrap\bin\publish\version.dll</BootstrapDll>
    </PropertyGroup>
    <Target Name="BuildBootstrap" BeforeTargets="Build" Inputs="@(BootstrapSource)" Outputs="$(BootstrapDll)">
        <Warning Condition="!Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe')" Text="Visual Studio C++ build tools not found: bootstrap\ (version.dll) was not rebuilt." />
        <Exec Condition="Exists('$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe')" Command="dotnet publish &quot;..\bootstrap\Bootstrap.csproj&quot; -nologo -v:m" />
        <!-- The publish may find nothing to relink (e.g. a comment changed): mark the output current, or this runs every build. -->
        <Touch Condition="Exists('$(BootstrapDll)')" Files="$(BootstrapDll)" />
    </Target>


    <!-- Every build copies the loader into <DeployDir>\HOI4ModLoader\core and version.dll next to hoi4.exe. Locked files (game running) only warn. -->
    <Target Name="DeployCore" AfterTargets="Build" Condition="'$(DeployPath)' != ''">
        <ItemGroup>
            <!-- FASM.DLL is the 32-bit assembler; hoi4.exe is 64-bit and uses FASMX64.DLL. -->
            <_CoreFile Include="$(OutDir)**\*" Exclude="$(OutDir)**\*.targets;$(OutDir)FASM.DLL" />
            <_CoreFile Remove="$(OutDir)**\*.pdb" Condition="!$(DeploySymbols)" />
        </ItemGroup>
        <Delete Condition="!$(DeploySymbols)" Files="$(DeployPath)\HOI4ModLoader\core\$(TargetName).pdb" ContinueOnError="WarnAndContinue" /> <!-- a stale one would not match -->
        <Copy SourceFiles="@(_CoreFile)" DestinationFiles="@(_CoreFile->'$(DeployPath)\HOI4ModLoader\core\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" />
        <!-- The licenses travel with the binaries (LGPL, and the third-party notices for what core\ ships). -->
        <Copy SourceFiles="..\LICENSE;..\THIRD-PARTY-NOTICES.md" DestinationFolder="$(DeployPath)\HOI4ModLoader" SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" />
        <Copy Condition="Exists('$(BootstrapDll)')" SourceFiles="$(BootstrapDll)" DestinationFolder="$(DeployPath)" SkipUnchangedFiles="true" Retries="0" ContinueOnError="WarnAndContinue" />
    </Target>

</Project>
